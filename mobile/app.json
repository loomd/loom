{
  "expo": {
    "name": "Loom Remote",
    "slug": "loom-remote",
    "version": "0.8.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "loom-remote",
    "splash": {
      "backgroundColor": "#0a0a0f"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "package": "loom.ccxcc.cn",
      "versionCode": 15,
      "usesCleartextTraffic": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset"
    ],
    "updates": {
      "url": "https://u.expo.dev/placeholder"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
